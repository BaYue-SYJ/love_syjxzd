input, textarea { border: 1rpx solid #ffd1e5; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; }
.picker { background:#fff6fa; padding:16rpx; border-radius:12rpx; margin-bottom:16rpx; }
.preview { width: 100%; border-radius: 16rpx; margin: 12rpx 0; }
.row { display:flex; justify-content:space-between; margin-bottom:10rpx; }
.title { font-weight:700; color:#ff4f9a; }
.date { color:#888; font-size:24rpx; }
