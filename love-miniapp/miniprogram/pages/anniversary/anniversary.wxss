input { border: 1rpx solid #ffd1e5; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; }
.picker { background:#fff6fa; padding:16rpx; border-radius:12rpx; margin-bottom:16rpx; }
.row { display:flex; justify-content:space-between; margin-bottom:12rpx; }
.title { font-weight:700; color:#ff4f9a; }
.tag { color:#fff; background:#ff8fbf; padding:4rpx 14rpx; border-radius:20rpx; font-size:22rpx; }
.countdown { color:#ff4f9a; margin-top:10rpx; }
