.hero {
  height: 520rpx;
  position: relative;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  overflow: hidden;
}
.bg,.mask { position:absolute; left:0; top:0; width:100%; height:100%; }
.mask { background: rgba(255, 105, 160, 0.35); }
.center { position: relative; z-index: 2; color: #fff; text-align: center; padding-top: 80rpx; }
.days { font-size: 72rpx; font-weight: bold; margin: 20rpx 0; }
.avatars { display: flex; justify-content: center; align-items: center; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; border: 4rpx solid #fff; }
.heart { margin: 0 20rpx; font-size: 42rpx; }
.words { padding: 20rpx 40rpx; font-size: 26rpx; }
.nav-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 24rpx; }
.nav-item { text-align:center; font-weight:600; color:#ff4f9a; }
.full { grid-column: 1 / span 2; }
